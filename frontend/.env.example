# Verdant Environment Variables
# Copy this file to .env.local and fill in values

# Alchemy RPC — required for Ethereum, Arbitrum, Base, and Solana
ALCHEMY_API_KEY_ETHEREUM=
ALCHEMY_API_KEY_ARBITRUM=
ALCHEMY_API_KEY_BASE=
ALCHEMY_API_KEY_SOLANA=

# Solana RPC — required for Solana execution (client-side)
NEXT_PUBLIC_SOLANA_RPC_URL=

# Zerion API - required for position data
ZERION_API_KEY=

# WalletConnect — required for wallet connection
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# NEAR Intents — required for cross-chain routing (Milestone 2)
NEAR_INTENTS_API_KEY=

# Pendle Hosted SDK — required for Pendle integration (Milestone 3)
PENDLE_HOSTED_SDK_API_KEY=

# 1inch Swap API — required for in-sequence token swaps (server-side, Bearer auth).
# When unset, the 1inch swap option is simply unavailable.
ONEINCH_API_KEY=

# Supabase — required for user preferences and history
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for Drizzle ORM (server-side DB access).
# For Supabase, use the connection-pooler URI from Project Settings → Database
# (Transaction pooler, port 6543), e.g.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Tenderly — optional, for transaction simulation
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT_SLUG=
TENDERLY_PROJECT_SLUG=

# Upstash Redis — OPTIONAL. Activates the shared, global rate-limit store
# (SPECS §19) so the limit is enforced across all serverless instances. When
# either var is unset, rate limiting falls back to the in-memory per-instance
# default. Get both from the Upstash console (REST API section).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
